# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# Signs login tokens. At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# How long a sign-in lasts, in minutes
JWT_EXPIRE_MINUTES=60

# Where the SQLite database lives (defaults to app.db next to server.py)
# DATABASE_PATH=
